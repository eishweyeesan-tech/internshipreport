# ── InternReport System Security Configuration ─────────────────
# Disable Directory Listing / Browsing completely
Options -Indexes

# Set default directory index files
DirectoryIndex index.php login.php

# Prevent direct access to sensitive file types and configurations
<FilesMatch "(^\.htaccess|^\.git|composer\.(json|lock)|package(-lock)?\.json|\.env|\.sql|\.log|\.md)$">
    Require all denied
</FilesMatch>

# Security Headers (if mod_headers is enabled)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
