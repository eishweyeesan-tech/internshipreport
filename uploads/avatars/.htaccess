# Deny execution of scripts in uploads directory
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|cgi|pl|asp|aspx|shtml|sh|lua)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</FilesMatch>

# Allow image files
<FilesMatch "\.(?i:jpg|jpeg|png|gif|webp)$">
    <IfModule mod_authz_core.c>
        Require all granted
    </IfModule>
    <IfModule !mod_authz_core.c>
        Allow from all
    </IfModule>
</FilesMatch>

Options -Indexes
