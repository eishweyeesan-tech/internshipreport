# Deny execution of scripts in uploads directory
<FilesMatch "\.(?i:php|phtml|php3|php4|php5|php7|phps|cgi|pl|asp|aspx|shtml|sh|lua)$">
    Deny from all
</FilesMatch>

# Allow only image files
<FilesMatch "\.(?i:jpg|jpeg|png|gif|webp)$">
    Allow from all
</FilesMatch>

# Default deny
Options -Indexes
